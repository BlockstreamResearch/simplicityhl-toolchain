#!/usr/bin/env bash

set -euo pipefail

main() {
  local requested_version

  requested_version="$(parse_simplex_version "${SIMPLEX_VERSION:-latest}")"
  install_simplex "$requested_version"
  say 'done'
}

say() {
  printf 'simplicityhl-toolchain: %s\n' "$1"
}

err() {
  say "$1" >&2
  exit 1
}

need_cmd() {
  if ! command -v "$1" &>/dev/null; then
    err "need '$1' (command not found)"
  fi
}

trim() {
  local value="$1"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"

  printf '%s\n' "$value"
}

parse_simplex_version() {
  local version

  version="$(trim "$1")"
  if [ -z "$version" ]; then
    version=latest
  elif [[ "$1" == *$'\n'* || ! "$version" =~ ^v?[0-9A-Za-z][0-9A-Za-z._+-]*$ ]]; then
    err "invalid version for 'simplex': '$version'"
  fi

  printf '%s\n' "$version"
}

append_path() {
  local bin_dir="$1"

  export PATH="$bin_dir:$PATH"
  if [ -n "${GITHUB_PATH:-}" ]; then
    printf '%s\n' "$bin_dir" >> "$GITHUB_PATH"
  fi
}

write_key_value_out() {
  local name="$1"
  local value="$2"

  if [ -z "${GITHUB_OUTPUT:-}" ]; then
    err 'GITHUB_OUTPUT is not set'
  fi
  printf '%s=%s\n' "$name" "$value" >> "$GITHUB_OUTPUT"
}

reported_version() {
  local version_output="$1"

  if [[ "$version_output" =~ v?([0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return
  fi

  err "could not determine the installed simplex version from: $version_output"
}

# Use REST API version 2026-03-10 for GitHub.
github_api() {
  local url="$1"
  local media_type="${2:-application/vnd.github+json}"
  local output="${3:--}"

  local -a args=(
    --fail
    --silent
    --show-error
    --location
    --retry 10
    --retry-all-errors
    --retry-delay 1
    --proto '=https'
    --tlsv1.2
    --header "Accept: $media_type"
    --header 'X-GitHub-Api-Version: 2026-03-10'
  )

  if [ -n "${GITHUB_TOKEN:-}" ]; then
    args+=(--header "Authorization: Bearer $GITHUB_TOKEN")
  fi

  curl "${args[@]}" --output "$output" "$url"
}

resolve_simplex_tag() {
  local requested_version="$1"
  local release_json
  local tag

  if [ "$requested_version" != latest ]; then
    if [[ "$requested_version" == v* ]]; then
      printf '%s\n' "$requested_version"
    else
      printf 'v%s\n' "$requested_version"
    fi
    return
  fi

  say 'resolving the latest Simplex release' >&2
  release_json="$(github_api 'https://api.github.com/repos/BlockstreamResearch/smplx/releases/latest')" || \
    err 'failed to resolve the latest Simplex release'
  tag="$(jq -er '.tag_name | strings | select(length > 0)' <<< "$release_json")" || \
    err 'the latest Simplex release does not contain a tag name'

  printf '%s\n' "$tag"
}

run_simplexup() (
  local tag="$1"
  local simplex_dir="$2"
  local temp_dir
  local simplexup_path
  local simplexup_url
  local encoded_tag

  temp_dir="$(mktemp -d)" || err 'failed to create a temporary directory'
  trap 'rm -rf "$temp_dir"' EXIT
  simplexup_path="$temp_dir/simplexup"
  encoded_tag="$(jq -rn --arg tag "$tag" '$tag | @uri')" || return 1

  simplexup_url="https://api.github.com/repos/BlockstreamResearch/smplx/contents/simplexup/simplexup?ref=$encoded_tag"
  github_api "$simplexup_url" 'application/vnd.github.raw+json' "$simplexup_path" || return 1

  chmod +x "$simplexup_path" || return 1

  # Released simplexup scripts make API requests without using GITHUB_TOKEN.
  # Export this override only from this subshell, keeping credentials off asset URLs.
  # Invoked by the downloaded simplexup script.
  #
  # shellcheck disable=SC2329
  curl() {
    local arg

    for arg in "$@"; do
      if [[ "$arg" == https://api.github.com/* ]] && [ -n "${GITHUB_TOKEN:-}" ]; then
        command curl --header "Authorization: Bearer $GITHUB_TOKEN" "$@"
        return
      fi
    done

    command curl "$@"
  }
  export -f curl

  SIMPLEX_DIR="$simplex_dir" "$simplexup_path" --install "$tag"
)

install_simplex() {
  local requested_version="$1"
  local tag
  local base_dir
  local simplex_dir
  local simplex_bin_dir
  local version_output
  local installed_version

  need_cmd curl
  need_cmd git
  need_cmd jq

  tag="$(resolve_simplex_tag "$requested_version")"
  base_dir="${XDG_CONFIG_HOME:-$HOME}"
  simplex_dir="${SIMPLEX_DIR:-$base_dir/.simplex}"
  simplex_bin_dir="$simplex_dir/bin"

  say "installing simplex@$tag"
  if ! run_simplexup "$tag" "$simplex_dir"; then
    err "failed to install simplex@$tag for $(uname -s)/$(uname -m); verify the version and architecture at https://github.com/BlockstreamResearch/smplx/releases"
  fi

  append_path "$simplex_bin_dir"
  need_cmd simplex
  version_output="$(simplex --version)"
  installed_version="$(reported_version "$version_output")"
  write_key_value_out simplex-version "$installed_version"
}

main "$@"
